POSTGRES_PASSWORD=local-development-only
# Run python scripts/configure_notebooks.py to generate a private service token.
JUPYTERHUB_API_TOKEN=replace-me
# Docker Engine default. With Podman, enable its API socket and set its host path.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Absolute path on the container host; generated automatically for this checkout.
# DATA_ROOT=/absolute/path/to/kaggle-platform/data

# Shared image for interactive notebooks and isolated CPU evaluation jobs.
ARENA_RUNTIME_IMAGE=arena-singleuser:cpu-2026.09.1

# Optional OpenAI-compatible chat-completions providers for benchmarks.
# URL must include the full /v1/chat/completions path; never put a key in the URL.
# Example: [{"id":"local-llm","label":"Local LLM","model":"my-model","url":"http://host.containers.internal:8000/v1/chat/completions"}]
BENCHMARK_PROVIDERS_JSON=[]
# To use this key, set "key_env":"BENCHMARK_API_KEY" on the provider entry.
BENCHMARK_API_KEY=

# Training limits in seconds (OpenShift renderer defaults to longer GPU sessions).
NOTEBOOK_CELL_TIMEOUT_SECONDS=120
EVALUATION_TIMEOUT_SECONDS=900
